# 이 파일을 .env 로 복사한 뒤 값을 채우세요(.env 는 공유·커밋 금지).
#
#   cp .env.example .env
#
# 14~22일차·35일차에 쓰던 OpenAI 키를 그대로 씁니다(모델 gpt-5.6-luna).
# 없으면 준비 셀에서 안내와 함께 멈춥니다. 오가는 요청이 몇 건뿐이라 비용은 아주 적습니다.
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-여기에-본인-키

# NEO4J_* 는 반드시 채웁니다. 실습 전용 Neo4j 여야 합니다(실습이 그래프를 지우고 새로 만듭니다).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=자기-로컬-비밀번호
