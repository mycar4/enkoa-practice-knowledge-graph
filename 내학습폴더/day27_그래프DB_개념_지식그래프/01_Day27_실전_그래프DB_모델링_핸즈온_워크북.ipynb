   "source": [
    "## 3. RDB 중첩 루프 JOIN vs LPG 그래프 포인터 홉 성능 비교"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "⚡ [연산 속도 측정 결과 (1,000건 데이터 기준)]\n",
      "• RDB 모의 2중 스캔 JOIN 소요 시간: 0.1250 ms\n",
      "• LPG 포인터 홉 탐색 소요 시간   : 0.0150 ms\n",
      "• 그래프 속도 향상 배수: 약 8.3배 빠름!\n",
      "✅ [결론] 데이터가 수백만 건으로 증가할수록 그래프의 Index-Free Adjacency가 압도적 우위를 점합니다.\n"
     ]
    }
   ],
   "source": [
    "# 1,000건의 모의 주주-기업 관계 데이터 생성\n",
    "mock_holdings = [{\"holder_id\": f\"H_{i % 50}\", \"corp_id\": f\"C_{i % 200}\", \"ratio\": 5.0 + (i % 10)} for i in range(1000)]\n",
    "\n",
    "# 1) RDB 방식 모의 연산 (2중 스캔)\n",
    "t0 = time.perf_counter()\n",
    "target_corp = \"C_0\"\n",
    "step1 = [r[\"holder_id\"] for r in mock_holdings if r[\"corp_id\"] == target_corp]\n",
    "rdb_res = [r for r in mock_holdings if r[\"holder_id\"] in step1 and r[\"corp_id\"] != target_corp]\n",
    "t_rdb = (time.perf_counter() - t0) * 1000\n",
    "\n",
    "# 2) LPG 그래프 방식 (인접 포인터 순회)\n",
    "bench_g = LPGGraph()\n",
    "for r in mock_holdings:\n",
    "    bench_g.add_node(r[\"holder_id\"], [\"Shareholder\"])\n",
    "    bench_g.add_node(r[\"corp_id\"], [\"Company\"])\n",
    "    bench_g.add_relationship(\"HOLDS\", r[\"holder_id\"], r[\"corp_id\"], {\"ratio\": r[\"ratio\"]})\n",
    "\n",
    "t1 = time.perf_counter()\n",
    "c_node = bench_g.nodes[target_corp]\n",
    "lpg_res = [out_r for in_r in c_node.in_edges for out_r in in_r.source.out_edges if out_r.target.id != target_corp]\n",
    "t_lpg = (time.perf_counter() - t1) * 1000\n",
    "\n",
    "print(\"⚡ [연산 속도 측정 결과 (1,000건 데이터 기준)]\")\n",
    "print(f\"• RDB 모의 2중 스캔 JOIN 소요 시간: {t_rdb:.4f} ms\")\n",
    "print(f\"• LPG 포인터 홉 탐색 소요 시간   : {t_lpg:.4f} ms\")\n",
    "print(f\"• 그래프 속도 향상 배수: 약 {t_rdb / t_lpg:.1f}배 빠름!\")\n",
    "print(\"✅ [결론] 데이터가 수백만 건으로 증가할수록 그래프의 Index-Free Adjacency가 압도적 우위를 점합니다.\")"
   ]
  },
