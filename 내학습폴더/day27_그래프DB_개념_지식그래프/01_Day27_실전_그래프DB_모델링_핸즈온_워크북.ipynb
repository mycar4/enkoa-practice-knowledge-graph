   "source": [
    "## 2. [ART:READY] 미대입시 다단계 전형 및 실기 일정 LPG 모델링"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "🎨 [ART 입시 LPG 그래프 구축 완료] 노드 7개, 관계 6건\n",
      "🔍 [중앙대 서울캠퍼스 1단계 실기 전형조건 탐색 결과]:\n",
      "  └─ 대학: [중앙대학교(서울)], 전형: [2027 수시 실기형]\n",
      "     => 1단계 실기: [소묘] (반영비: 80.0%), 고사일: [2026-10-03]\n"
     ]
    }
   ],
   "source": [
    "art_g = LPGGraph()\n",
    "\n",
    "# 1) 대학, 학과, 전형, 실기종목, 일정 노드 생성\n",
    "cau_seoul = art_g.add_node(\"CAU_SEOUL\", [\"University\"], {\"name\": \"중앙대학교\", \"campus\": \"서울\"})\n",
    "cau_anseong = art_g.add_node(\"CAU_ANSEONG\", [\"University\"], {\"name\": \"중앙대학교\", \"campus\": \"안성\"})\n",
    "dept_spatial = art_g.add_node(\"DEPT_SPATIAL\", [\"Department\"], {\"name\": \"공간연출전공\"})\n",
    "track_2027 = art_g.add_node(\"CAU_2027_EARLY\", [\"AdmissionTrack\"], {\"name\": \"2027 수시 실기형\", \"year\": 2027})\n",
    "p_drawing = art_g.add_node(\"PRACTICAL_DRAWING\", [\"PracticalType\"], {\"name\": \"소묘\"})\n",
    "p_interview = art_g.add_node(\"PRACTICAL_INTERVIEW\", [\"PracticalType\"], {\"name\": \"질의응답(면접)\"})\n",
    "exam_1 = art_g.add_node(\"EXAM_20261003\", [\"ExamSchedule\"], {\"exam_date\": \"2026-10-03\"})\n",
    "\n",
    "# 2) 관계 결속 (학과 소속, 전형 개설, 단계별 실기/일정)\n",
    "art_g.add_relationship(\"BELONGS_TO\", \"DEPT_SPATIAL\", \"CAU_SEOUL\")\n",
    "art_g.add_relationship(\"OFFERS_TRACK\", \"CAU_SEOUL\", \"CAU_2027_EARLY\", {\"year\": 2027})\n",
    "art_g.add_relationship(\"REQUIRES_PRACTICAL\", \"CAU_2027_EARLY\", \"PRACTICAL_DRAWING\", {\"stage\": 1, \"ratio\": 80.0})\n",
    "art_g.add_relationship(\"REQUIRES_PRACTICAL\", \"CAU_2027_EARLY\", \"PRACTICAL_INTERVIEW\", {\"stage\": 2, \"ratio\": 30.0})\n",
    "art_g.add_relationship(\"EXAM_ON\", \"CAU_2027_EARLY\", \"EXAM_20261003\", {\"stage\": 1})\n",
    "\n",
    "print(f\"🎨 [ART 입시 LPG 그래프 구축 완료] 노드 {len(art_g.nodes)}개, 관계 {len(art_g.relationships)}건\")\n",
    "\n",
    "# 3) 경로 탐색: 중앙대 서울 -> 전형 -> 1단계 실기 및 일정\n",
    "print(\"🔍 [중앙대 서울캠퍼스 1단계 실기 전형조건 탐색 결과]:\")\n",
    "for out_rel in cau_seoul.out_edges:\n",
    "    if out_rel.type == \"OFFERS_TRACK\":\n",
    "        track = out_rel.target\n",
    "        for t_rel in track.out_edges:\n",
    "            if t_rel.type == \"REQUIRES_PRACTICAL\" and t_rel.properties.get(\"stage\") == 1:\n",
    "                p_type = t_rel.target\n",
    "                for s_rel in track.out_edges:\n",
    "                    if s_rel.type == \"EXAM_ON\" and s_rel.properties.get(\"stage\") == 1:\n",
    "                        print(f\"  └─ 대학: [{cau_seoul.properties['name']}({cau_seoul.properties['campus']})], 전형: [{track.properties['name']}]\")\n",
    "                        print(f\"     => 1단계 실기: [{p_type.properties['name']}] (반영비: {t_rel.properties['ratio']}%), 고사일: [{s_rel.target.properties['exam_date']}]\")"
   ]
  },
